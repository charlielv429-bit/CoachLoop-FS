{
  "openapi": "3.1.0",
  "info": {
    "title": "CoachLoop main prelesson routes",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/lesson-plans/draft": {
      "post": {
        "summary": "Draft",
        "operationId": "draft_api_v1_lesson_plans_draft_post",
