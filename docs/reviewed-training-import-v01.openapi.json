            "title": "Trusted Review Sequence"
          },
          "observation_summary_eligible": {
            "type": "boolean",
            "title": "Observation Summary Eligible"
          },
          "technical_error_assessment": {
            "type": "string",
            "const": "not_assessed",
            "title": "Technical Error Assessment"
          },
          "imported_review_claims": {
            "items": {
              "$ref": "#/components/schemas/ImportedClaimSummary"
