          "frame_end": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Frame End"
          },
          "start_time_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start Time Ms",
