            "x-max-decimal-places": 16383,
            "x-max-integer-digits": 131072
          },
          "end_time_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "End Time Ms",
            "description": "Exact finite PostgreSQL NUMERIC; parse with arbitrary precision, not binary float.",
            "x-max-decimal-places": 16383,
            "x-max-integer-digits": 131072
          },
          "deviation_max": {
            "type": "number",
            "minimum": 0.0,
            "title": "Deviation Max",
