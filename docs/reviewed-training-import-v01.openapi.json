            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "source_event_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^evt_[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
