{
  "openapi": "3.1.0",
  "info": {
    "title": "CoachLoop-FS V1.1 local console only",
    "description": "LocalBoundary requires direct loopback, bootstrap cookie, exact Origin and CSRF header. Not a Coze or public API. V1 deployed API unchanged.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8767"
    }
  ],
  "paths": {
    "/api/v1/lesson-plans/themes": {
      "get": {
        "summary": "Themes",
        "operationId": "themes_api_v1_lesson_plans_themes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/lesson-plans/adaptive-draft": {
      "post": {
        "summary": "Draft",
        "operationId": "draft_api_v1_lesson_plans_adaptive_draft_post",
        "security": [
          {
            "LocalConsoleSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdaptiveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdaptiveResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact http://127.0.0.1:<port> origin required by LocalBoundary"
          },
          {
            "name": "X-CoachLoop-Console",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdaptationData": {
        "properties": {
          "theme_id": {
            "type": "string",
            "title": "Theme Id"
          },
          "theme_version": {
