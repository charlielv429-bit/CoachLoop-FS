            "title": "Theme Version"
          },
          "source": {
            "$ref": "#/components/schemas/SourceData"
          },
          "verification_status": {
            "type": "string",
            "const": "unverified",
            "title": "Verification Status"
          },
          "prerequisites_missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prerequisites Missing"
          },
          "goals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Goals"
          },
          "core_exercises": {
            "items": {
              "$ref": "#/components/schemas/PracticeData"
            },
            "type": "array",
            "title": "Core Exercises"
          },
          "organization": {
            "$ref": "#/components/schemas/OrganizationData"
          },
          "staff_tasks": {
            "items": {
              "$ref": "#/components/schemas/DutyData"
            },
            "type": "array",
            "title": "Staff Tasks"
          },
          "evaluation_indicators": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evaluation Indicators"
          },
          "safety_limits": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Safety Limits"
          },
          "differentiation": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Differentiation"
          },
          "teacher_goal_edit": {
            "type": "string",
            "title": "Teacher Goal Edit"
          },
          "teacher_notes": {
            "type": "string",
            "title": "Teacher Notes"
          },
          "teacher_review_checklist": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Teacher Review Checklist"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "theme_id",
          "theme_version",
          "source",
          "verification_status",
          "prerequisites_missing",
          "goals",
          "core_exercises",
          "organization",
          "staff_tasks",
          "evaluation_indicators",
          "safety_limits",
          "differentiation",
          "teacher_goal_edit",
          "teacher_notes",
          "teacher_review_checklist"
        ],
        "title": "AdaptationData"
      },
      "AdaptiveLoad": {
        "properties": {
          "total_minutes": {
            "type": "integer",
            "const": 45,
            "title": "Total Minutes",
            "default": 45
          },
          "kind": {
            "type": "string",
            "const": "estimated",
            "title": "Kind",
            "default": "estimated"
          },
          "avg_hr": {
            "type": "null",
            "title": "Avg Hr"
          },
          "group_density": {
            "$ref": "#/components/schemas/LoadMetric"
          },
          "individual_density": {
            "$ref": "#/components/schemas/LoadMetric"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "group_density",
          "individual_density",
          "note"
        ],
        "title": "AdaptiveLoad"
      },
      "AdaptivePlan": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "teacher_input": {
            "$ref": "#/components/schemas/TeacherInput"
          },
          "guiding_ideology": {
            "$ref": "#/components/schemas/GuidingIdeology"
          },
          "teaching_material_analysis": {
            "$ref": "#/components/schemas/TeachingMaterialAnalysis"
          },
          "learner_analysis": {
            "$ref": "#/components/schemas/LearnerAnalysis"
          },
          "teaching_flow": {
            "$ref": "#/components/schemas/TeachingFlow"
          },
          "venue_equipment": {
            "$ref": "#/components/schemas/VenueEquipment"
          },
          "safety_precautions": {
            "$ref": "#/components/schemas/SafetyPrecautions"
          },
          "load_accounting": {
            "$ref": "#/components/schemas/AdaptiveLoad"
          },
          "evidence_log": {
            "items": {
              "$ref": "#/components/schemas/EvidenceEntry"
            },
            "type": "array",
            "title": "Evidence Log"
          },
          "review_status": {
            "type": "string",
            "const": "draft",
            "title": "Review Status",
            "default": "draft"
          },
          "plan_version": {
            "type": "string",
            "const": "1.1.0",
            "title": "Plan Version",
            "default": "1.1.0"
          },
          "complete_plan": {
            "type": "string",
            "title": "Complete Plan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "teacher_input",
          "guiding_ideology",
          "teaching_material_analysis",
          "learner_analysis",
          "teaching_flow",
          "venue_equipment",
          "safety_precautions",
          "load_accounting",
          "evidence_log",
          "complete_plan"
        ],
        "title": "AdaptivePlan"
      },
      "AdaptiveRequest": {
        "properties": {
          "class_label": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Class Label",
            "default": "匿名班级"
          },
          "theme_id": {
            "type": "string",
            "enum": [
              "safety_equipment",
              "fall_recovery",
              "marching",
              "two_foot_glide",
              "posture",
              "basic_stop",
              "alternating_push",
              "one_foot_glide",
              "swizzles",
              "backward_two_foot",
              "two_foot_turn",
              "curve_glide",
              "forward_inside",
              "forward_outside",
              "backward_one_foot",
              "forward_crossovers",
              "circle_glide",
              "rhythm",
              "backward_edges",
              "backward_crossovers",
              "three_turn",
              "mohawk",
              "two_foot_spin",
              "step_sequence"
            ],
            "maxLength": 40,
            "minLength": 1,
            "title": "Theme Id",
            "default": "two_foot_glide"
          },
          "student_count": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Student Count"
          },
          "skill_level": {
            "type": "string",
            "enum": [
              "零基础",
              "初级",
              "初中级",
              "中级"
            ],
            "title": "Skill Level"
          },
          "age_band": {
            "type": "string",
            "enum": [
              "儿童",
              "青少年",
              "成人",
              "混合年龄"
            ],
            "title": "Age Band",
            "default": "青少年"
          },
          "mastered_skills": {
            "items": {
              "type": "string",
              "enum": [
                "safety_equipment",
                "fall_recovery",
                "marching",
                "two_foot_glide",
                "posture",
                "basic_stop",
                "alternating_push",
                "one_foot_glide",
                "swizzles",
                "backward_two_foot",
                "two_foot_turn",
                "curve_glide",
                "forward_inside",
                "forward_outside",
                "backward_one_foot",
                "forward_crossovers",
                "circle_glide",
                "rhythm",
                "backward_edges",
                "backward_crossovers",
                "three_turn",
                "mohawk",
                "two_foot_spin",
                "step_sequence"
              ]
            },
            "type": "array",
            "maxItems": 24,
            "uniqueItems": true,
            "title": "Mastered Skills"
          },
          "coach_count": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Coach Count"
          },
          "teacher_count": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Teacher Count"
          },
          "total_minutes": {
            "type": "integer",
            "maximum": 45.0,
            "minimum": 45.0,
            "title": "Total Minutes",
            "default": 45
          },
          "usable_area_m2": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Usable Area M2"
          },
          "declared_practice_capacity": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Declared Practice Capacity"
          },
          "equipment_sets": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Equipment Sets",
            "description": "齐备且可用的个人冰鞋护具套数"
          },
          "safe_waiting_area": {
            "type": "boolean",
            "title": "Safe Waiting Area"
          },
          "ice_available": {
            "type": "boolean",
            "title": "Ice Available",
            "default": true
          },
          "venue_conditions": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Venue Conditions"
          },
          "equipment_conditions": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Equipment Conditions"
          },
          "goal_preference": {
            "type": "string",
            "enum": [
              "基础控制",
              "动作质量",
              "左右均衡",
              "衔接节奏"
            ],
            "title": "Goal Preference",
            "default": "基础控制"
          },
          "teacher_goal_edit": {
            "type": "string",
            "maxLength": 500,
            "title": "Teacher Goal Edit",
            "default": ""
          },
          "teacher_notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Teacher Notes",
            "default": ""
          },
          "teacher_exercise_edits": {
            "anyOf": [
              {
                "maxItems": 0
              },
              {
                "maxItems": 3,
                "minItems": 3
              }
            ],
            "items": {
              "type": "string",
              "maxLength": 500,
              "pattern": "^[^\\x00-\\x1f\\x7f]*$"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Teacher Exercise Edits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_count",
          "skill_level",
          "coach_count",
          "teacher_count",
          "usable_area_m2",
          "declared_practice_capacity",
          "equipment_sets",
          "safe_waiting_area",
          "venue_conditions",
          "equipment_conditions"
        ],
        "title": "AdaptiveRequest"
      },
      "AdaptiveResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "adaptive-prelesson-v1.1",
            "title": "Schema Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft_ready",
              "needs_confirmation"
            ],
            "title": "Status"
          },
          "requires_teacher_review": {
            "type": "boolean",
            "const": true,
            "title": "Requires Teacher Review"
          },
          "knowledge_status": {
            "type": "string",
            "const": "unverified",
            "title": "Knowledge Status"
          },
          "review_status": {
            "type": "string",
            "const": "draft",
            "title": "Review Status"
          },
          "request": {
            "$ref": "#/components/schemas/AdaptiveRequest"
          },
          "lesson_plan": {
            "$ref": "#/components/schemas/AdaptivePlan"
          },
          "adaptation": {
            "$ref": "#/components/schemas/AdaptationData"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "status",
          "requires_teacher_review",
          "knowledge_status",
          "review_status",
          "request",
          "lesson_plan",
          "adaptation"
        ],
        "title": "AdaptiveResponse"
      },
      "DutyData": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "coach",
              "teacher"
            ],
            "title": "Role"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "task": {
            "type": "string",
            "title": "Task"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "number",
          "task"
        ],
        "title": "DutyData"
      },
      "ErrorDetail": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "type",
          "msg"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/ErrorDetail"
                },
                "type": "array"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "EventClaim": {
        "type": "string",
        "enum": [
          "observation",
          "confirmed_error"
        ],
        "title": "EventClaim"
      },
      "EventRef": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Event Id",
            "description": "V4事件标识；仅ASCII字母、数字、下划线和连字符，最多64字符"
          },
          "feature": {
            "type": "string",
            "minLength": 1,
            "title": "Feature",
            "description": "特征名（knee_angle_deg 等）"
          },
          "frame_start": {
            "type": "integer",
            "title": "Frame Start",
            "description": "起始帧"
          },
          "frame_end": {
            "type": "integer",
            "title": "Frame End",
            "description": "结束帧"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "normal_movement",
              "tracking_error",
              "uncertain"
            ],
            "title": "Review Status",
            "description": "事件人工审核状态"
          },
          "deviation_max": {
            "type": "number",
            "title": "Deviation Max",
            "description": "偏离幅度（若 V4 提供）",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "feature",
          "frame_start",
          "frame_end",
          "review_status"
        ],
        "title": "EventRef",
        "description": "引用某条 V4 事件（不得描述为已确认技术错误，除非教练确认）。"
      },
      "EvidenceEntry": {
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "title": "Statement",
            "description": "教案内的陈述/依据"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource",
            "description": "来源/数据状态标记"
          },
          "citation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation",
            "description": "引用标注（文件·章节/页码）；未核实则必须为 None"
          },
          "event_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventRef"
              },
              {
                "type": "null"
              }
            ],
            "description": "若引用 V4 事件，须填写以触发状态保护"
          },
          "event_claim": {
            "$ref": "#/components/schemas/EventClaim",
            "default": "observation"
          }
        },
        "type": "object",
        "required": [
          "statement",
          "source"
        ],
        "title": "EvidenceEntry"
      },
      "EvidenceSource": {
        "type": "string",
        "enum": [
          "teacher_input",
          "kb_evidence",
          "real_analysis",
          "design_assumption",
          "unverified"
        ],
        "title": "EvidenceSource",
        "description": "证据来源/数据状态标记。"
      },
      "GroupData": {
        "properties": {
          "wave": {
            "type": "integer",
            "title": "Wave"
          },
          "coach": {
            "type": "integer",
            "title": "Coach"
          },
          "students": {
            "type": "integer",
            "title": "Students"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "wave",
          "coach",
          "students"
        ],
        "title": "GroupData"
      },
      "GuidingIdeology": {
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content",
            "description": "指导思想内容"
          },
          "motor_competence": {
            "type": "string",
            "minLength": 1,
            "title": "Motor Competence",
            "description": "运动能力维度可观察目标"
          },
          "healthy_behavior": {
            "type": "string",
            "minLength": 1,
            "title": "Healthy Behavior",
            "description": "健康行为维度可观察目标"
          },
          "sports_ethics": {
            "type": "string",
            "minLength": 1,
            "title": "Sports Ethics",
            "description": "体育品德维度可观察目标"
          }
        },
        "type": "object",
        "required": [
          "content",
          "motor_competence",
          "healthy_behavior",
          "sports_ethics"
        ],
        "title": "GuidingIdeology"
      },
      "LearnerAnalysis": {
        "properties": {
          "student_profile": {
            "type": "string",
            "minLength": 1,
            "title": "Student Profile",
            "description": "学生基础（学段/人数/水平）"
          },
          "common_difficulties": {
            "type": "string",
            "title": "Common Difficulties",
            "description": "常见学习困难",
            "default": ""
          },
          "tiered_plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tiered Plan",
            "description": "分层教学需求"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "description": "数据区分说明",
            "default": "已确认事实/未经审核姿态事件/待核实推测需在教案中以证据来源明确区分。"
          }
        },
        "type": "object",
        "required": [
          "student_profile"
        ],
        "title": "LearnerAnalysis"
      },
      "LoadMetric": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "指标名"
          },
          "kind": {
            "$ref": "#/components/schemas/MeasurementKind",
            "description": "预计值或实测值"
          },
          "formula": {
            "type": "string",
            "title": "Formula",
            "description": "计算公式（含分子/分母/单位说明）"
          },
          "numerator": {
            "type": "number",
            "minimum": 0.0,
            "title": "Numerator",
            "description": "原始精度分子"
          },
          "denominator": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Denominator",
            "description": "原始精度分母"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
